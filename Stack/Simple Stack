x=int(input("Enter your STACK limit:"))
top=-1
arr=[]
def Push(arr,top):
    if(top==x-1):
        print("Stack Overflow")
    else:
        y=int(input("Enter the element you want to push:"))
        arr.append(y)
        top+=1
        print(top)
        print(arr)
        return arr,top

def Pop(arr,top):
    if(top==-1):
        print("Stack underflow")
    else:
        y=arr.pop(top)
        top-=1
        print("Element",y,"is poped")
        return arr,top

def Display(arr):
    print(arr)

