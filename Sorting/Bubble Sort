n=int(input("Enter the number of element"))
arr=[]
for i in range(0,n,1):
    x=int(input("Enter your element:"))
    arr.append(x)
print("Array before sorting:")
print(arr)
for i in range(n-1,0,-1):
    for j in range(0,i,1):
        if(arr[j]>arr[j+1]):
            temp=arr[j]
            arr[j]=arr[j+1]
            arr[j+1]=temp
print("Sorted array is:")
print(arr)
